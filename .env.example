# Copy to .env and adjust if you need to. The defaults work out of the box.
#   cp .env.example .env

# ---- Postgres (service: db) ----
POSTGRES_USER=revenue
POSTGRES_PASSWORD=revenue
POSTGRES_DB=revenue_db

# Host port for the database. Changed from 5432 so it never collides with a
# Postgres you may already run locally.
DB_PORT=5433

# ---- Rails API (service: api) ----
RAILS_ENV=development
API_PORT=3001

# Signing key for admin JWTs. Any long random string works locally.
# Generate a real one with:  openssl rand -hex 32
JWT_SECRET=dev_only_change_me_0000000000000000000000000000000000000000000000

# Production only — Rails refuses to boot without it, and docker-compose.prod.yml
# refuses to start rather than inventing one. Leave it unset for development.
#   openssl rand -hex 64
# SECRET_KEY_BASE=

# Browser origin allowed to call the API (CORS).
CORS_ORIGINS=http://localhost:3000

# Hostnames Rails accepts in development. Server-rendered pages reach the API
# as http://api:3000, so "api" must be here. Only change this if you rename
# the api service in docker-compose.yml.
ALLOWED_HOSTS=api

# ---- Next.js frontend (service: web) ----
WEB_PORT=3000

# Where the browser reaches the API. This runs in the user's browser, not in
# the container, so it must be a host address — not http://api:3000.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Where server components reach the API. They run inside the web container,
# so they use the Docker network name. docker-compose sets this for you;
# only override it when running outside Docker.
# API_INTERNAL_URL=http://api:3000

# ---- Seed data ----
# Credentials created by `rails db:seed`. Documented in the README.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=password123
