# Secrets and local config.
#
# Deny every .env variant and allow back only the committed template. Listing
# names one at a time loses to whoever invents .env.uat next week — and the
# file that gets missed is the one holding real credentials.
.env*
!.env.example
*.pem
*.key

# Rails
/api/tmp/
/api/log/
/api/storage/
/api/.bundle/
/api/vendor/bundle/
/api/config/master.key

# Next.js
/web/node_modules/
/web/.next/
/web/out/
/web/next-env.d.ts

# Playwright
/web/test-results/
/web/playwright-report/
/web/blob-report/

# Docker volumes
/.docker-data/

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp
