# Node 24 (LTS). Required, not incidental: jsdom 27 (the test environment)
# calls require() on ES modules, which only works from Node 22.12 onward.
FROM node:24-alpine

# pnpm installed directly rather than through Corepack: Corepack is no longer
# bundled with Node from v25, so depending on it would give this image an
# expiry date.
#
# The version here only bootstraps. pnpm 10 reads `packageManager` from
# package.json and switches to whatever it names, so that field stays the
# single source of truth — this pin just avoids a download on first run.
RUN npm install -g pnpm@10.19.0

WORKDIR /app

# Install dependencies first so this layer is cached across source edits.
# --frozen-lockfile fails rather than silently resolving something new.
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

EXPOSE 3000

# dev:docker rather than dev — it adds `-H 0.0.0.0`, without which the dev
# server binds an interface the host cannot reach. Kept as a script so the
# start-up flags live in package.json with the others, not buried here.
CMD ["pnpm", "run", "dev:docker"]
